# ============================================================
# 🤖 MODEL VE SAĞLAYICI SEÇİMİ (LLM_PROVIDER)
# Seçenekler: "gemini", "groq", "openrouter", "ollama", "openai"
# ============================================================
LLM_PROVIDER=groq

# ------------------------------------------------------------
# 1. GOOGLE GEMINI (Varsayılan)
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------------------------
# 2. GROQ (Açık Kaynak Modeller - Ücretsiz & Işık Hızında)
# API Anahtarı: https://console.groq.com/keys
# Aktif Modeller: "qwen/qwen3.6-27b", "openai/gpt-oss-20b", "openai/gpt-oss-120b"
# ------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# ------------------------------------------------------------
# 3. OPENROUTER (Yüzlerce Model Tek API ile)
# API Anahtarı: https://openrouter.ai/keys
# Popüler Modeller: meta-llama/llama-3.3-70b-instruct, qwen/qwen-2.5-72b-instruct
# ------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ------------------------------------------------------------
# 4. YEREL OLLAMA (Bilgisayarınızda Çalıştırmak İsterseniz)
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ------------------------------------------------------------
# 5. DEEPSEEK (Orijinal Bulut API - İndirme Gerektirmez)
# API Anahtarı: https://platform.deepseek.com
# Modeller: "deepseek-chat" (V3), "deepseek-reasoner" (R1)
# ------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------
# 6. OPENAI
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# ✈️ MCP SERVER AYARLARI
# ============================================================
PUBLIC_MCP_URL=http://localhost:8000/mcp
